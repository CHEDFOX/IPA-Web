# Copy to .env (on the server) or .env.local (on your laptop).

# ---- required

# The admin panel password. At least 10 characters; the panel refuses to sign anyone in
# without it. Change it by editing this file and restarting the app.
ADMIN_PASSWORD=change-me-to-a-long-password

# The public address of the site, without a trailing slash. Used for link previews,
# QR codes and the sitemap. Read when the app starts, so changing it needs a restart only.
SITE_URL=https://yourdomain.com

# ---- deployment

# Your domain, used by deploy/Caddyfile to get the HTTPS certificate.
DOMAIN=yourdomain.com

# Where the SQLite database and the uploaded photos live. Back this folder up.
# Docker sets this to /app/data by itself.
IPA_DATA_DIR=./data

# ---- optional

# How many unused access codes each property keeps ready. Default 10.
IPA_CODE_POOL=10

# How long an unlocked property stays open, in minutes. The clock restarts while the
# visitor is on the site, so this is really "how long after they leave". Default 10.
IPA_UNLOCK_MINUTES=10

# Set to 1 to ignore the database and run the built-in sample listings instead (lib/demo.ts).
# Leave it out for a real site.
IPA_DEMO=0

# Only needed if something outside this app has to clear the page cache; the admin panel
# does it by itself after every edit.
REVALIDATE_SECRET=
