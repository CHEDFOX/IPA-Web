# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables instead.

# Address of the IPA backend on your VPS, without a trailing slash.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# The public address of this website, without a trailing slash. Used for link
# previews, QR codes and the sitemap. On Vercel it defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Must match REVALIDATE_SECRET in the backend's .env so edits show straight away.
REVALIDATE_SECRET=change-me-to-a-long-random-string
