# Address of the IPA backend (the API on your VPS), without a trailing slash.
# Used by the browser for the enquiry form, and by the server to load listings.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Optional: a faster private address for server-side requests when the website
# runs on the same VPS as the backend, e.g. http://127.0.0.1:4000
API_INTERNAL_URL=

# The public address of this website, without a trailing slash.
# Used for link previews, QR codes, the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Shared secret: must match REVALIDATE_SECRET in the backend's .env so the
# backend can tell this site to refresh right after you edit a listing.
REVALIDATE_SECRET=change-me-to-a-long-random-string
