# Running without Docker: systemd + nginx (see deploy/nginx.conf).
#
#   sudo cp deploy/ipa-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ipa-web

[Unit]
Description=IPA website, admin panel and media server
After=network.target

[Service]
Type=simple
User=ipa
WorkingDirectory=/opt/ipa-web
EnvironmentFile=/opt/ipa-web/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=IPA_DATA_DIR=/opt/ipa-web/data
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

# The app only ever writes to its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ipa-web/data /opt/ipa-web/.next

[Install]
WantedBy=multi-user.target
